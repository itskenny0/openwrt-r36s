 #include "FileSorts.h"
 #include "views/gamelist/IGameListView.h"
 #include "guis/GuiInfoPopup.h"
+
+namespace {
+int handheldPercentage(const char* command, int fallback)
+{
+	char value[16] = {};
+	FILE* pipe = popen(command, "r");
+	if (!pipe) return fallback;
+	bool read = fgets(value, sizeof(value), pipe) != nullptr;
+	int status = pclose(pipe);
+	if (!read || status != 0) return fallback;
+	char* end = nullptr;
+	long parsed = strtol(value, &end, 10);
+	if (end == value || (*end != '\n' && *end != 0) || parsed < 0 || parsed > 100) return fallback;
+	return static_cast<int>(parsed);
+}
+}
 
