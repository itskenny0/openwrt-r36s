+bool ImageIO::resizeFile(const std::string& path, int maxWidth, int maxHeight)
+{
+	if (maxWidth == 0 && maxHeight == 0) return true;
+	if (maxWidth < 0 || maxHeight < 0 || maxWidth > 4096 || maxHeight > 4096) return false;
+	SDL_RWops* input = SDL_RWFromFile(path.c_str(), "rb");
+	if (!input) return false;
+	Sint64 bytes = SDL_RWsize(input);
+	if (bytes <= 0 || bytes > 32 * 1024 * 1024) { SDL_RWclose(input); return false; }
+	auto original = rgba(IMG_Load_RW(input, 1));
+	if (!original || original->w <= 0 || original->h <= 0) return false;
+	if (!maxWidth) maxWidth = std::max(1, maxHeight * original->w / original->h);
+	if (!maxHeight) maxHeight = std::max(1, maxWidth * original->h / original->w);
+	if (maxWidth > 4096 || maxHeight > 4096) return false;
+	Surface resized(SDL_CreateRGBSurfaceWithFormat(0, maxWidth, maxHeight, 32, SDL_PIXELFORMAT_RGBA32), SDL_FreeSurface);
+	if (!resized || SDL_SoftStretchLinear(original.get(), nullptr, resized.get(), nullptr) != 0) return false;
+	// Publish a complete PNG atomically. Content detection also handles a
+	// downloaded file retaining its original JPEG/WebP filename extension.
+	std::string temporary = path + ".XXXXXX";
+	int fd = mkstemp(&temporary[0]);
+	if (fd < 0) return false;
+	FILE* file = fdopen(fd, "wb");
+	if (!file) { close(fd); unlink(temporary.c_str()); return false; }
+	SDL_RWops* output = SDL_RWFromFP(file, SDL_TRUE);
+	if (!output) { fclose(file); unlink(temporary.c_str()); return false; }
+	bool saved = IMG_SavePNG_RW(resized.get(), output, 0) == 0;
+	if (SDL_RWclose(output) != 0) saved = false;
+	if (saved) saved = rename(temporary.c_str(), path.c_str()) == 0;
+	if (!saved) unlink(temporary.c_str());
+	return saved;
 }
 
