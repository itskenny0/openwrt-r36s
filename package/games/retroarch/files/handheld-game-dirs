#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
# A missing/unwritable games volume must never become a save directory on the
# small OS overlay, even when first-boot provisioning did not finish.
awk '$2 == "/easyroms" && $4 ~ /(^|,)rw(,|$)/ { found=1 } END { exit !found }' /proc/mounts || {
	echo 'Game storage is not mounted read-write at /easyroms.' >&2
	exit 1
}
set -- /easyroms/bios /easyroms/saves /easyroms/states
while IFS='|' read -r system _; do
	case "$system" in ''|'#'*) continue ;; esac
	set -- "$@" "/easyroms/$system" "/easyroms/saves/$system" "/easyroms/states/$system"
done < /usr/share/retroarch/systems.tsv
mkdir -p "$@"
# Leave user-provided BIOS and asset directories intact, including on ROM cards.
for assets in /usr/share/retroarch/system/*; do
	[ -d "$assets" ] || continue
	name=${assets##*/}
	destination="/easyroms/bios/$name"
	[ -e "$destination" ] || [ -L "$destination" ] && continue
	ln -s "$assets" "$destination" 2>/dev/null && continue
	# FAT/exFAT games cards cannot store symlinks. Publish a complete copy only.
	temporary=$(mktemp -d "/easyroms/bios/.$name.XXXXXX")
	if cp -R "$assets/." "$temporary/" && mv "$temporary" "$destination"; then
		continue
	fi
	rm -rf "$temporary"
	exit 1
done
