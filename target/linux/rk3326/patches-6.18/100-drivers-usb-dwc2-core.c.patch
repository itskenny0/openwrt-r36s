diff --git a/drivers/usb/dwc2/core.c b/drivers/usb/dwc2/core.c
index f375c51..2b06ed1 100644
--- a/drivers/usb/dwc2/core.c
+++ b/drivers/usb/dwc2/core.c
@@ -434,6 +434,7 @@ int dwc2_core_reset(struct dwc2_hsotg *hsotg, bool skip_wait)
 					      GRSTCTL_CSFTRST, 10000)) {
 			dev_warn(hsotg->dev, "%s: HANG! Soft Reset timeout GRSTCTL_CSFTRST\n",
 				 __func__);
+			hsotg->core_reset_failed = 1;
 			return -EBUSY;
 		}
 	} else {
@@ -441,6 +442,7 @@ int dwc2_core_reset(struct dwc2_hsotg *hsotg, bool skip_wait)
